{
  "name": "demo-registry-widget",
  "version": "1.2.0",
  "description": "Ultra-light demo registry widget (TSV-based, no JSON)",
  "homepage": "https://github.com/P1oN/demo-registry-widget#readme",
  "bugs": {
    "url": "https://github.com/P1oN/demo-registry-widget/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P1oN/demo-registry-widget.git"
  },
  "author": "P1oN",
  "type": "module",
  "main": "./dist/full.min.js",
  "types": "./dist/full.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/full.d.ts",
      "import": "./dist/full.min.js"
    },
    "./full": {
      "types": "./dist/full.d.ts",
      "import": "./dist/full.min.js"
    },
    "./micro": {
      "types": "./dist/micro.d.ts",
      "import": "./dist/micro.min.js"
    },
    "./styles": "./dist/default-styles.css"
  },
  "scripts": {
    "build": "npm run build:ts && npm run styles:build",
    "build:ts": "tsup",
    "build:watch": "tsup --watch",
    "styles:build": "node scripts/build-styles.mjs",
    "styles:watch": "node scripts/watch-styles.mjs",
    "playground": "node scripts/serve-static.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "node --test test/unit.test.mjs",
    "test:watch": "node --test --watch test/unit.test.mjs",
    "test:types": "tsc --noEmit -p test/tsconfig.json",
    "test:pack": "node test/pack-smoke.mjs",
    "test:fast": "npm run build && npm run test:unit && npm run test:types",
    "test:ci": "npm run build && npm run test:unit && npm run test:types && npm run test:pack",
    "test": "npm run test:fast",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "license": "MIT",
  "keywords": [
    "demo",
    "registry",
    "widget",
    "performance",
    "tsv",
    "frontend"
  ]
}
